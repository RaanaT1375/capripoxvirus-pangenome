/*
    Minimal profile for continuous integration.

    Runs against small synthetic sequences committed under assets/test_data/ and
    is normally combined with -stub-run, which executes each process's stub
    block instead of the real command. That verifies the workflow wiring -- every
    channel, join and output declaration -- in seconds, without installing any
    bioinformatics tool.

        nextflow run . -profile test -stub-run --outdir results_test

    The synthetic data cannot reproduce any published result. For that, use the
    archived samplesheet and the validation targets in docs/scripts.md.
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic data to verify pipeline wiring'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    input = "${projectDir}/assets/test_samplesheet.csv"

    // point the references at the committed stand-ins rather than the real
    // files, which are too large to version and are fetched separately
    lsdv_reference = "${projectDir}/assets/test_data/test_reference.fasta"
    lsdv_proteome  = "${projectDir}/assets/test_data/test_proteome.faa"

    skip_selection      = true
    skip_phylogeography = true

    scoary_permutations = 20
    gubbins_iterations  = 2
    iqtree_bootstrap    = 100
    mk_bootstrap        = 100
}

process {
    // stubs are trivial; keep CI fast and avoid retry loops on synthetic input
    errorStrategy = 'terminate'
    maxRetries    = 0
}
