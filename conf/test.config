/*
    Minimal profile for CI. Runs the pangenome and phylogenomic stages on a
    handful of genomes so that the DAG and module wiring are exercised without
    downloading references or the bacterial index.

        nextflow run . -profile test,conda --outdir results_test
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Small dataset to verify pipeline wiring'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'

    input = "${projectDir}/assets/test_samplesheet.csv"

    skip_selection      = true
    skip_phylogeography = true

    scoary_permutations = 20
    gubbins_iterations  = 2
    iqtree_bootstrap    = 100
    mk_bootstrap        = 100
}
