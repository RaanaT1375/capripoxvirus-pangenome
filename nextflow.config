/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    capripoxvirus-pangenome  --  Nextflow configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'capripoxvirus-pangenome'
    author          = 'Raana Tabashiri'
    homePage        = 'https://github.com/RaanaT1375/capripoxvirus-pangenome'
    description     = 'Pangenome, recombination and selection analysis of the Capripoxvirus genus'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '2.0.0'
    doi             = '10.5281/zenodo.21996311'
}

params {
    // ---- input / output ---------------------------------------------------
    input  = null
    outdir = null
    help   = false

    // ---- references -------------------------------------------------------
    // AF325528.1 is the attenuated LSDV Neethling vaccine strain used as the
    // synteny and contamination-screening backbone. GCF_000839805.1 is the LSDV
    // RefSeq assembly whose proteome guides Prokka annotation.
    lsdv_reference     = "${projectDir}/assets/references/AF325528.1.fasta"
    lsdv_proteome      = "${projectDir}/assets/references/GCF_000839805.1_protein.faa"
    host_bowtie2_index = null   // directory of Bos taurus / Ovis aries / Capra hircus indices
    bacteria_mmi       = null   // minimap2 index of RefSeq bacterial representative genomes

    // ---- read QC (fastp) --------------------------------------------------
    fastp_qual_phred          = 20
    fastp_unqualified_percent = 20
    fastp_cut_mean_quality    = 25
    fastp_min_length          = 50

    // ---- assembly ---------------------------------------------------------
    min_contig_len        = 500    // first-pass assemblies (SPAdes --careful)
    min_contig_len_rescue = 1000   // re-assemblies after bacterial depletion
    cds_flag_threshold    = 200    // predicted CDS above which depletion is triggered

    // ---- pangenome QC -----------------------------------------------------
    contamination_max      = 0.20  // max fraction of proteins with no hit to the LSDV proteome
    max_missing_near_core  = 9
    near_core_threshold    = 0.97
    diamond_evalue         = 1e-5

    // ---- pangenome partitioning ------------------------------------------
    core_threshold      = 0.99
    soft_core_threshold = 0.95
    shell_threshold     = 0.15

    // ---- phylogenomics ----------------------------------------------------
    iqtree_bootstrap = 1000
    iqtree_model     = 'MFP'

    // ---- recombination and structure --------------------------------------
    gubbins_iterations = 5
    gubbins_treebuilder = 'raxml'

    // ---- phylogeography ---------------------------------------------------
    pastml_model          = 'F81'
    pastml_prediction     = 'MPPA'
    subsampling_replicates = 10
    skip_phylogeography   = false

    // ---- pan-GWAS ---------------------------------------------------------
    scoary_permutations = 1000
    scoary_start_col    = 15
    // An association is reported only if it satisfies BOTH the per-trait
    // Bonferroni-corrected p and the permutation empirical p.
    scoary_bonferroni_p = 0.05
    scoary_empirical_p  = 0.05
    tier1_min_pairs     = 3

    // ---- selection --------------------------------------------------------
    skip_selection    = false
    hyphy_fdr         = 0.05
    relax_models      = 'Minimal'
    mk_freq_cutoff    = 0.05
    mk_freq_sweep     = '0,0.01,0.02,0.05,0.10,0.15'
    mk_consensus_min  = 0.90   // outgroup agreement required to call an ancestral codon
    mk_coverage_min   = 0.90   // ingroup coverage required at a codon
    mk_bootstrap      = 10000
    mk_seed           = 20260817

    // ---- resource ceilings ------------------------------------------------
    max_cpus   = 32
    max_memory = '120.GB'
    max_time   = '48.h'

    // ---- reporting --------------------------------------------------------
    publish_dir_mode = 'copy'
    tracedir         = "${params.outdir}/pipeline_info"
}

includeConfig 'conf/base.config'

profiles {
    conda {
        conda.enabled          = true
        conda.channels         = ['conda-forge', 'bioconda', 'defaults']
        docker.enabled         = false
        singularity.enabled    = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        conda.channels         = ['conda-forge', 'bioconda', 'defaults']
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    slurm  { includeConfig 'conf/slurm.config' }
    test   { includeConfig 'conf/test.config'  }
}

// ---- execution reporting --------------------------------------------------
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline { enabled = true; file = "${params.tracedir}/execution_timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.tracedir}/execution_report_${trace_timestamp}.html"   }
trace    { enabled = true; file = "${params.tracedir}/execution_trace_${trace_timestamp}.txt"     }
dag      { enabled = true; file = "${params.tracedir}/pipeline_dag_${trace_timestamp}.html"       }

// ---- resource ceiling helper ----------------------------------------------
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            return obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1
                ? params.max_memory as nextflow.util.MemoryUnit : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            return obj.compareTo(params.max_time as nextflow.util.Duration) == 1
                ? params.max_time as nextflow.util.Duration : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) } catch (all) { return obj }
    }
}
